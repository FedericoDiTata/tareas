# Sincronización entre computadoras (opcional).
# Sin estas variables la app funciona igual, guardando todo en este navegador.
# Cómo obtenerlas: ver SUPABASE.md

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alternativa: la clave vieja "anon public" (eyJ...). Con una de las dos alcanza.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
